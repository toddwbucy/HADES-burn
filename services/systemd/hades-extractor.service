[Unit]
Description=HADES Document Extraction Service (Docling gRPC)
Documentation=https://github.com/r3d91ll/HADES-Burn
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
# UMask=0007 ensures the Unix domain socket is created group-connectable
# (0660/0770 family) at bind time — no post-bind chmod race. Matches the
# daemon unit. The in-server chmod remains as a fallback for non-systemd
# invocations and as an abort-if-unusable check.
UMask=0007
Type=simple
User=hades
Group=hades
SupplementaryGroups=weaver-admin arangodb

# /run/hades is created solely by tmpfiles.d/hades.conf. Deliberately NO
# RuntimeDirectory= here: the three hades units shared RuntimeDirectory=hades,
# and systemd removes a unit's RuntimeDirectory on stop — so any one service
# stopping unlinked the OTHER services' live sockets (observed 2026-07-20:
# starting the extractor clobbered hades.sock and training.sock).
# /var/cache/hades for HF model cache — referenced by ReadWritePaths below.
CacheDirectory=hades
CacheDirectoryMode=0755

# @SERVICES_DIR@ is substituted with the actual services/ path at install
# time (`make install-extractor`, or scripts/install/hades-install.sh
# --with-services), so this unit isn't pinned to any one workstation.
WorkingDirectory=@SERVICES_DIR@
ExecStart=@SERVICES_DIR@/.venv/bin/python -m extraction.server

# Environment from config file
EnvironmentFile=/etc/hades/extractor.conf

# Restart policy
Restart=on-failure
RestartSec=10

# Resource limits
LimitNOFILE=65536
LimitMEMLOCK=infinity

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/run/hades /var/cache/hades

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hades-extractor

[Install]
WantedBy=multi-user.target
